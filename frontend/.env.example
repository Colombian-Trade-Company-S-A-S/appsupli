# URL base de la API. Si usas el proxy de Vite deja "/api".
VITE_API_URL=/api

# Target del proxy en desarrollo (opcional, apunta al backend local)
VITE_API_PROXY_TARGET=http://localhost:8000
# Para probar el frontend local contra el backend de Render, usa esta en su lugar:
# VITE_API_PROXY_TARGET=https://supli-api-backend.onrender.com

VITE_APP_NAME=appSupli

# Ingreso con Microsoft (Entra ID). Opcional: por defecto usa la app de SUPLI,
# la misma del backend. Viven en el frontend para que el botón no dependa del
# backend (en el plan gratis de Render se duerme).
# VITE_MICROSOFT_TENANT_ID=2ff22c76-1647-48cc-81ae-36b57a4a192b
# VITE_MICROSOFT_CLIENT_ID=06ed2626-9f44-4faf-a85d-89ac03203664
