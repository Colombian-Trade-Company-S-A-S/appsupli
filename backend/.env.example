DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-only-cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vida de los tokens JWT (minutos / días)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Base de datos. Sin esta variable se usa el SQLite local.
# Desde tu equipo: la «External Database URL» de Render, con ?sslmode=require.
# En Render: la «Internal Database URL».
# DATABASE_URL=postgresql://usuario:clave@host:5432/base?sslmode=require

# Solo producción: dominios https del frontend y del backend.
# CORS_ALLOWED_ORIGINS=https://appsupli.onrender.com
# CSRF_TRUSTED_ORIGINS=https://appsupli.onrender.com
