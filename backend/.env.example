DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-only-cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vida de los tokens JWT (minutos / días)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Base de datos. Sin DB_HOST se usa el SQLite local.
# Desde tu equipo: los datos de la «External Database URL» de Render.
# En Render (mismo servicio): los de la «Internal Database URL», sin SSL.
# DB_HOST=dpg-xxxxxxxx-a.oregon-postgres.render.com
# DB_PORT=5432
# DB_NAME=nombre_de_la_base
# DB_USER=usuario
# DB_PASSWORD=clave
# DB_SSLMODE=require
# Schema donde viven las tablas de Supli (se crea con `manage.py crear_schema`).
# DB_SCHEMA=app_supli

# Solo producción: dominios https del frontend y del backend.
# CORS_ALLOWED_ORIGINS=https://appsupli.onrender.com
# CSRF_TRUSTED_ORIGINS=https://appsupli.onrender.com
